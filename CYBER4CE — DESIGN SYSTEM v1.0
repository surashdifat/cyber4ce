/* ═══════════════════════════════════════════
   CYBER4CE — DESIGN SYSTEM v1.0
   Unified Cyber Security Theme
   ═══════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');

/* ─── Color Variables ─── */
:root {
    --bg-primary: #0B1120;
    --bg-secondary: #1E293B;
    --bg-tertiary: #0F172A;
    --bg-card: #111C30;
    --neon-cyan: #06B6D4;
    --neon-red: #EF4444;
    --neon-green: #10B981;
    --neon-orange: #F59E0B;
    --neon-purple: #8B5CF6;
    --text-primary: #E2E8F0;
    --text-muted: #94A3B8;
    --text-dim: #64748B;
    --border-subtle: #334155;
    --font-mono: 'Share Tech Mono', monospace;
    --font-display: 'Orbitron', sans-serif;
}

/* ─── Main App Background ─── */
.stApp {
    background-color: var(--bg-primary);
    background-image: 
        radial-gradient(circle at 20% 20%, rgba(6, 182, 212, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(239, 68, 68, 0.05) 0%, transparent 50%);
    color: var(--text-primary);
    font-family: var(--font-mono);
}

/* ─── Hide Streamlit Default Elements ─── */
#MainMenu { visibility: hidden; }
footer { visibility: hidden; }
header { background: transparent !important; }

/* ─── Sidebar ─── */
[data-testid="stSidebar"] {
    background-color: var(--bg-tertiary);
    border-right: 1px solid var(--border-subtle);
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.5);
}

[data-testid="stSidebar"] h1 {
    color: var(--neon-cyan) !important;
    font-family: var(--font-display) !important;
    text-shadow: 0 0 10px rgba(6, 182, 212, 0.7);
    font-size: 22px !important;
}

/* ─── Sidebar Navigation Buttons ─── */
[data-testid="stSidebar"] .stRadio > div {
    flex-direction: column;
    gap: 10px;
}

[data-testid="stSidebar"] .stRadio label {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 14px 18px;
    transition: all 0.3s ease;
    cursor: pointer;
    width: 100%;
    color: var(--text-primary) !important;
    font-family: var(--font-mono);
    font-size: 14px;
    position: relative;
    overflow: hidden;
}

[data-testid="stSidebar"] .stRadio label::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(6, 182, 212, 0.2), transparent);
    transition: left 0.5s;
}

[data-testid="stSidebar"] .stRadio label:hover::before {
    left: 100%;
}

[data-testid="stSidebar"] .stRadio label:hover {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.5);
    transform: translateX(5px);
}

[data-testid="stSidebar"] .stRadio div[role="radiogroup"] > label > div:first-child {
    display: none;
}

[data-testid="stSidebar"] .stRadio label[data-checked="true"],
[data-testid="stSidebar"] .stRadio label:has(input:checked) {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.15), rgba(6, 182, 212, 0.05));
    border-color: var(--neon-cyan);
    box-shadow: 0 0 20px rgba(6, 182, 212, 0.6);
}

/* ─── Headings ─── */
h1, h2, h3, h4 {
    color: var(--neon-cyan) !important;
    font-family: var(--font-display) !important;
    text-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
    letter-spacing: 1px;
}

/* ─── Metric Cards ─── */
[data-testid="stMetric"] {
    background-color: var(--bg-secondary);
    border: 1px solid var(--neon-cyan);
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.25);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

[data-testid="stMetric"]:hover {
    transform: translateY(-4px) scale(1.02);
    border-color: var(--neon-red);
    box-shadow: 0 0 25px rgba(239, 68, 68, 0.5);
}

[data-testid="stMetricLabel"] {
    color: var(--text-muted) !important;
    font-family: var(--font-mono) !important;
}

[data-testid="stMetricValue"] {
    color: var(--neon-cyan) !important;
    font-family: var(--font-display) !important;
    text-shadow: 0 0 10px rgba(6, 182, 212, 0.6);
}

/* ─── Buttons ─── */
.stButton > button {
    background: transparent;
    border: 2px solid var(--neon-cyan);
    color: var(--neon-cyan);
    padding: 12px 28px;
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: 1px;
    border-radius: 8px;
    transition: all 0.3s ease;
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.3);
    text-transform: uppercase;
    width: 100%;
}

.stButton > button:hover {
    background: var(--neon-cyan);
    color: var(--bg-primary);
    box-shadow: 0 0 25px var(--neon-cyan), 0 0 50px rgba(6, 182, 212, 0.5);
    transform: translateY(-2px);
}

.stButton > button:active {
    transform: translateY(0);
}

/* ─── Inputs ─── */
.stTextInput > div > div > input,
.stTextArea > div > div > textarea {
    background-color: var(--bg-secondary) !important;
    border: 1px solid var(--border-subtle) !important;
    color: var(--text-primary) !important;
    font-family: var(--font-mono) !important;
    border-radius: 8px !important;
    padding: 12px !important;
    transition: all 0.3s ease !important;
}

.stTextInput > div > div > input:focus,
.stTextArea > div > div > textarea:focus {
    border-color: var(--neon-cyan) !important;
    box-shadow: 0 0 15px rgba(6, 182, 212, 0.5) !important;
}

/* ─── Selectbox ─── */
.stSelectbox > div > div {
    background-color: var(--bg-secondary) !important;
    border: 1px solid var(--border-subtle) !important;
    border-radius: 8px !important;
    color: var(--text-primary) !important;
}

/* ─── Dataframe ─── */
[data-testid="stDataFrame"] {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    overflow: hidden;
}

/* ─── Tabs ─── */
.stTabs [data-baseweb="tab-list"] {
    gap: 8px;
    background-color: transparent;
}

.stTabs [data-baseweb="tab"] {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    padding: 10px 20px;
}

.stTabs [aria-selected="true"] {
    background-color: rgba(6, 182, 212, 0.15);
    border-color: var(--neon-cyan);
    color: var(--neon-cyan);
}

/* ─── Custom Classes ─── */
.cyber-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 24px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.cyber-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--neon-cyan);
    box-shadow: 0 0 15px var(--neon-cyan);
}

.cyber-card:hover {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 25px rgba(6, 182, 212, 0.3);
    transform: translateY(-4px);
}

.cyber-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-family: var(--font-mono);
    font-weight: bold;
    letter-spacing: 1px;
}

.badge-cyan { background: rgba(6, 182, 212, 0.15); color: var(--neon-cyan); border: 1px solid var(--neon-cyan); }
.badge-red { background: rgba(239, 68, 68, 0.15); color: var(--neon-red); border: 1px solid var(--neon-red); }
.badge-green { background: rgba(16, 185, 129, 0.15); color: var(--neon-green); border: 1px solid var(--neon-green); }
.badge-orange { background: rgba(245, 158, 11, 0.15); color: var(--neon-orange); border: 1px solid var(--neon-orange); }

/* ─── Glowing Text ─── */
.glow-cyan { color: var(--neon-cyan); text-shadow: 0 0 10px rgba(6, 182, 212, 0.8); }
.glow-red { color: var(--neon-red); text-shadow: 0 0 10px rgba(239, 68, 68, 0.8); }
.glow-green { color: var(--neon-green); text-shadow: 0 0 10px rgba(16, 185, 129, 0.8); }

/* ─── Animations ─── */
@keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 10px rgba(6, 182, 212, 0.5); }
    50% { box-shadow: 0 0 30px rgba(6, 182, 212, 0.9); }
}

@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0.3; }
}

.blink { animation: blink 1s infinite; }

@keyframes slide-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

.slide-up { animation: slide-up 0.8s ease-out; }

/* ─── Scrollbar ─── */
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg-primary); }
::-webkit-scrollbar-thumb { 
    background: var(--neon-cyan); 
    border-radius: 5px; 
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
}
::-webkit-scrollbar-thumb:hover { background: var(--neon-red); }

/* ─── Success/Warning/Error/Info Boxes ─── */
.stAlert {
    border-radius: 10px;
    font-family: var(--font-mono);
    border-left-width: 4px;
}
